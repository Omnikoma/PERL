
# ==========================================
# PERL - Git Ignore Configuration
# ==========================================

# 1. Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.so

# 2. Virtual environments
.venv/
venv/
env/
ENV/
.pdm-python

# 3. Sensitive and local configuration
.env
.env.*
!.env.example
.pypirc

# 4. IDE and operating system files
.DS_Store
.idea/
.vscode/
tempCodeRunnerFile.py

# 5. Python build and distribution files
build/
dist/
*.egg-info/
.eggs/
*.egg

# 6. Generated training artifacts
checkpoints/
processed/
outputs/
logs/
*.log
*.pt
*.pth
*.ckpt
eval_report.json

# 7. Dataset management
# Exclude raw datasets while retaining
# the small KuaiRec example dataset.
/data/*
!/data/KuaiRec_example/

# 8. TimesFM pretrained model weights
# Download separately as described in README
weights/**/*.safetensors
weights/**/*.bin

# 9. Experiment tracking artifacts
wandb/
runs/
tensorboard/
events.out.tfevents.*


# Streamlit
.streamlit/secrets.toml
